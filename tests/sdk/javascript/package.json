{
  "name": "switchboard-sdk-javascript-tests",
  "version": "1.0.0",
  "description": "Test suite for Switchboard JavaScript SDK",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:client": "jest client.test.js",
    "test:message-builder": "jest message-builder.test.js",
    "test:integration": "jest integration.test.js",
    "test:websocket": "jest websocket.test.js"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/jest": "^29.5.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@babel|core-js)/)"
    ],
    "moduleFileExtensions": ["js", "json"],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "../../../sdk/javascript/src/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "testTimeout": 10000,
    "verbose": true
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "18"
          },
          "modules": "commonjs"
        }
      ]
    ]
  }
}