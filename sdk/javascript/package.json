{
  "name": "switchboard-client",
  "version": "1.0.0",
  "description": "Real-time educational communication SDK for Switchboard V4",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./dist/switchboard-client.cjs"
    }
  },
  "files": [
    "src/",
    "examples/",
    "dist/",
    "index.js",
    "switchboard-client.js",
    "switchboard-client.d.ts",
    "test-integration.html",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js -w",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "websocket",
    "real-time",
    "education",
    "communication",
    "sdk"
  ],
  "author": "Switchboard Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/switchboard/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/switchboard/sdk/issues"
  },
  "homepage": "https://github.com/switchboard/sdk#readme",
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}